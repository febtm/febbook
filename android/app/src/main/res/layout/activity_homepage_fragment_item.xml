<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:orientation="vertical"
    android:id = "@+id/hp_item_LL"
    android:background="@color/colorStudyMaterials"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorTertiary"
        android:layout_margin="2dp">

        <ImageButton
            android:id="@+id/hp_delete"
            android:layout_width="10dp"
            android:layout_margin="5dp"
            android:visibility="gone"
            android:contentDescription="@null"
            android:layout_height="10dp"
            android:layout_gravity="end"
            android:background="@drawable/app_delete_on"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

        <LinearLayout
            android:id="@+id/hp_userprofile"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="5dp">

            <com.pkmmte.view.CircularImageView
                android:id="@+id/hp_item_userimage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/hp_item_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/username"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textSize="14sp"
                android:layout_marginTop="5dp"/>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/hp_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="start">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:gravity="center"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"
                android:textStyle="bold"
                android:id="@+id/hp_item_title"
                android:textColor="@color/colorPrimary" />

            <ImageView
                android:id="@+id/hp_item_image"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:contentDescription="@null"
                android:layout_marginBottom="5dp"
                android:layout_gravity="center"
                android:visibility="gone"
                />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:layout_gravity="center_vertical"
                android:id="@+id/hp_item_description"
                android:textSize="14sp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/colorAccent" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timestamp"
                android:textSize="12sp"
                android:textColor="@color/colorQuaternary"
                android:gravity="end"
                android:id="@+id/hp_item_date" />

        </LinearLayout>

        </LinearLayout>


            <TextView
                android:id="@+id/hp_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_post"
                android:textSize="12sp"
                android:visibility="visible"
                android:layout_gravity="end"
                android:textColor="@color/colorSecondary"
                android:layout_margin="5dp"
                android:background="@color/colorTertiary" />

    </LinearLayout>

</LinearLayout>