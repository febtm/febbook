<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/c_scrollview"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSecondary"
        android:layout_margin="10dp"
        >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="2dp"
                android:background="@color/colorTertiary"
                android:padding="10dp"
                android:text="@string/contact"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"/>

    </LinearLayout>

            <LinearLayout
                android:id="@+id/c_message_LL"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_green_border"
                    android:layout_marginBottom="20dp"
                    >

                    <EditText
                        android:id="@+id/c_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorTertiary"
                        android:hint="@string/full_name"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/colorSecondary"
                        android:textStyle="bold"
                        android:gravity="start"
                        android:textSize="15sp"
                        android:padding="10dp"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_green_border"
                    android:layout_marginBottom="20dp"
                    >

                    <EditText
                        android:id="@+id/c_email"
                        android:inputType="textEmailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorTertiary"
                        android:hint="@string/email_id"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/colorSecondary"
                        android:gravity="start"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:padding="10dp"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_green_border"
                    android:layout_marginBottom="20dp"
                    >

                    <EditText
                        android:id="@+id/c_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorTertiary"
                        android:hint="@string/contact_subject"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/colorSecondary"
                        android:gravity="start"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:padding="10dp"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_green_border"
                    android:layout_marginBottom="40dp"
                    >

                    <EditText
                        android:id="@+id/c_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorTertiary"
                        android:hint="@string/type_in_your_message"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/colorSecondary"
                        android:gravity="start"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:padding="10dp"
                        />

                </LinearLayout>

                <Button
                    android:id="@+id/c_send"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:visibility="visible"
                    android:background="@color/colorPrimary"
                    android:text="@string/send_message"
                    android:textStyle="bold"
                    android:textColor="@color/colorTertiary"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>