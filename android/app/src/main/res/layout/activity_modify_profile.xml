<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ep_scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/ep_userimages"
                android:layout_marginBottom="40dp">

                <ImageView
                    android:id="@+id/ep_usercoverbutton"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:contentDescription="@null"
                    />

            <com.pkmmte.view.CircularImageView
                android:id="@+id/ep_userbutton"
                android:layout_width="@dimen/user_image_dimension"
                android:layout_height="@dimen/user_image_dimension"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="20dp" />

            </FrameLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                android:id="@+id/ep_linear1"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/RL_ep_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_usernametext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:hint="@string/modify_profile_username"
                        android:digits="@string/digits"
                        android:textColor="@color/colorPrimary"
                        android:maxLength="8"
                        android:textSize="15sp"
                        android:textColorHint="@color/colorAccent"
                        android:background="@color/colorSecondary"
                        android:padding="10dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/ep_abouttext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/about_me"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/colorAccent"
                        android:background="@color/colorSecondary"
                        android:padding="10dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_fullname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_fullnametext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/full_name"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/colorAccent"
                        android:background="@color/colorSecondary"
                        android:padding="10dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_emailtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@color/colorSecondary"
                        android:hint="@string/modify_profile_email_id"
                        android:textColorHint="@color/colorAccent"
                        android:padding="10dp" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/RL_ep_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/ep_gendertext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:text="@string/gender"
                        android:textStyle="bold"
                        android:background="@color/colorSecondary"
                        android:textColor="@color/colorPrimary"
                        android:padding="10dp"
                        android:textSize="15sp"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        />

                    <TextView
                        android:id="@+id/ep_genderm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@string/modify_profile_gender_male"
                        android:textColor="@color/colorPrimary"
                        android:layout_toStartOf="@+id/ep_genderswitch"
                        android:layout_alignBottom="@+id/ep_gendertext"
                        android:gravity="center_vertical"
                        android:padding="10dp" />

                    <Switch
                        android:id="@+id/ep_genderswitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_alignTop="@+id/ep_genderm"
                        android:layout_toStartOf="@+id/ep_genderf"
                        android:layout_alignBottom="@+id/ep_genderm"
                        android:track="@drawable/app_switch_track"
                        android:thumb="@drawable/app_switch_thumb"
                        android:padding="10dp"
                        />

                    <TextView
                        android:id="@+id/ep_genderf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@string/modify_profile_gender_female"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_alignBottom="@+id/ep_genderswitch"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:padding="10dp"/>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_birthdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_bdatetext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:background="@color/colorSecondary"
                        android:hint="@string/date_of_birth"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColorHint="@color/colorAccent"
                        android:padding="10dp"
                        />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/RL_ep_cpassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_cpasswordtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/colorPrimary"
                        android:background="@color/colorSecondary"
                        android:hint="@string/modify_profile_current_password"
                        android:textStyle="bold"
                        android:textColorHint="@color/colorAccent"
                        android:padding="10dp"
                        android:paddingEnd="30dp"
                        />

                    <CheckBox
                        android:id="@+id/ep_c_show_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|end"/>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/RL_ep_npassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_npasswordtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingEnd="30dp"
                        android:textColor="@color/colorPrimary"
                        android:background="@color/colorSecondary"
                        android:hint="@string/modify_profile_new_password"
                        android:textColorHint="@color/colorAccent"
                        android:padding="10dp"
                        />


                    <CheckBox
                        android:id="@+id/ep_n_show_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|end"/>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/RL_ep_cnpassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/ep_cnpasswordtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:paddingEnd="30dp"
                        android:textStyle="bold"
                        android:background="@color/colorSecondary"
                        android:hint="@string/modify_profile_confirm_new_password"
                        android:textColorHint="@color/colorAccent"
                        android:padding="10dp" />


                    <CheckBox
                        android:id="@+id/ep_cn_show_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|end"/>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_usertype"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorSecondary">

                    <Spinner
                        android:id="@+id/ep_usertypetext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:popupBackground="@color/colorSecondary" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorSecondary">

                    <Spinner
                        android:id="@+id/ep_coursetext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:popupBackground="@color/colorSecondary" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_collegename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/ep_collegenametext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/modify_profile_college_name"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColorHint="@color/colorAccent"
                        android:background="@color/colorSecondary"
                        android:textColor="@color/colorPrimary"
                        android:padding="10dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RL_ep_departmentname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_blue_border"
                    android:layout_marginBottom="40dp">


                    <EditText
                        android:id="@+id/ep_departmentnametext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/modify_profile_department_name"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColorHint="@color/colorAccent"
                        android:textColor="@color/colorPrimary"
                        android:background="@color/colorSecondary"
                        android:padding="10dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/ep_modify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@color/colorPrimary"
                    android:text="@string/modify_profile_modify_profile"
                    android:textStyle="bold"
                    android:textColor="@color/colorSecondary"
                    android:layout_marginBottom="20dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>