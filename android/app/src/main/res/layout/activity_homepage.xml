<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hp_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/hp_menu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical"
            android:background="@drawable/app_menu"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:text="@string/home"
            android:textSize="18sp"
            android:textColor="@color/colorSecondary" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/me_home"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="10dp">

        <EditText
            android:id="@+id/hp_search_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="40dp"
            android:padding="10dp"
            android:hint="@string/search_posts"
            android:background="@color/colorPrimaryTransparent77"
            android:textColorHint="@color/colorSecondary"
            android:textStyle="bold"
            android:inputType="textCapSentences"
            android:textSize="15sp"
            android:textColor="@color/colorSecondary"
            tools:ignore="RtlSymmetry" />

        <ImageButton
            android:id="@+id/hp_search_cancel"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:layout_gravity="end|center"
            android:background="@drawable/app_cancel" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/hp_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:layout_marginBottom="70dp"/>

        <ListView
            android:id="@+id/hp_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="70dp"
            android:layout_gravity="center_horizontal"/>

        <com.google.android.gms.ads.AdView
            android:id="@+id/hp_adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="10dp"
            ads:adUnitId="@string/hp_admob_banner">
        </com.google.android.gms.ads.AdView>

    </FrameLayout>

    </LinearLayout>

        <com.github.clans.fab.FloatingActionMenu
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:layout_gravity="end|bottom"
            fab:menu_fab_label="@string/hp_db"
            fab:menu_icon="@drawable/hp_fa_menu"
            fab:menu_colorNormal="@color/colorPrimary"
            fab:menu_colorPressed="@color/colorPrimaryTransparent77"
            fab:menu_colorRipple="@color/colorPrimaryTransparent77"
            fab:menu_fab_size="normal"
            fab:menu_animationDelayPerItem="55"
            fab:menu_backgroundColor="@android:color/transparent"
            fab:menu_buttonSpacing="0dp"
            fab:menu_openDirection="up"
            fab:menu_shadowColor="@color/colorPrimaryTransparent77"
            fab:menu_shadowRadius="4dp"
            fab:menu_shadowXOffset="1dp"
            fab:menu_shadowYOffset="4dp"
            fab:menu_showShadow="true"
            fab:menu_labels_colorNormal="@color/colorPrimary"
            fab:menu_labels_colorPressed="@color/colorPrimaryTransparent77"
            fab:menu_labels_colorRipple="@color/colorPrimaryTransparent77"
            fab:menu_labels_cornerRadius="6dp"
            fab:menu_labels_ellipsize="none"
            fab:menu_labels_hideAnimation="@anim/fab_slide_out_to_right"
            fab:menu_labels_margin="0dp"
            fab:menu_labels_maxLines="-1"
            fab:menu_labels_padding="4dp"
            fab:menu_labels_position="left"
            fab:menu_labels_showAnimation="@anim/fab_slide_in_from_right"
            fab:menu_labels_showShadow="true"
            fab:menu_labels_singleLine="false"
            fab:menu_labels_textColor="@color/colorSecondary"
            fab:menu_labels_textSize="14sp">

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/hp_fa_events"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/db_events"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini"
                ads:fab_label="@string/hp_db_events" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/hp_fa_materials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/db_materials"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini"
                ads:fab_label="@string/hp_db_materials" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/hp_fa_gk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/db_gk"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini"
                ads:fab_label="@string/hp_db_gk" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/hp_fa_tat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/db_tat"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini"
                ads:fab_label="@string/hp_db_tat" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/hp_fa_qna"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/db_qna"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini"
                ads:fab_label="@string/hp_db_qna" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/hp_fa_ideas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/db_ideas"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini"
                ads:fab_label="@string/hp_db_ideas" />

        </com.github.clans.fab.FloatingActionMenu>

    </FrameLayout>

</LinearLayout>