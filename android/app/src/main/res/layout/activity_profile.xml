<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/p_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/p_menu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical"
            android:background="@drawable/app_menu"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:text="@string/profile"
            android:textSize="18sp"
            android:textColor="@color/colorSecondary" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/me_profile"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="10dp">

            <EditText
                android:id="@+id/p_search_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="40dp"
                android:padding="10dp"
                android:hint="@string/p_search_users"
                android:background="@color/colorPrimaryTransparent77"
                android:textColorHint="@color/colorSecondary"
                android:textStyle="bold"
                android:inputType="textCapSentences"
                android:textSize="15sp"
                android:textColor="@color/colorSecondary"
                tools:ignore="RtlSymmetry" />

            <ImageButton
                android:id="@+id/p_search_cancel"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null"
                android:layout_gravity="end|center"
                android:background="@drawable/app_cancel" />

        </FrameLayout>

        <android.support.v7.widget.RecyclerView
            android:id="@+id/p_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <ListView
            android:id="@+id/p_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"/>

        <ScrollView
            android:id="@+id/p_user_info_scrollview"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">

                <ImageView
                    android:id="@+id/p_user_cover"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:contentDescription="@null" />

                <com.pkmmte.view.CircularImageView
                    android:id="@+id/p_user_image"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="20dp"
                    android:layout_gravity="center|bottom"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.gms.ads.AdView
                    android:id="@+id/p_adView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    ads:adSize="BANNER"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    ads:adUnitId="@string/p_admob_banner">
                </com.google.android.gms.ads.AdView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/username"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@color/colorSecondaryTransparent77"
                        android:textColor="@color/colorSecondary"
                        android:textSize="15sp"
                        android:padding="5dp"/>

                    <TextView
                        android:id="@+id/p_username_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/username"
                        android:textStyle="bold"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textColor="@color/colorSecondary"
                        android:background="@color/colorPrimaryTransparent77" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/about_me"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@color/colorSecondaryTransparent77"
                        android:textColor="@color/colorSecondary"
                        android:textSize="15sp"
                        android:padding="5dp"/>

                    <TextView
                        android:id="@+id/p_user_about_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_me"
                        android:textStyle="bold"
                        android:autoLink="web"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textColor="@color/colorSecondary"
                        android:background="@color/colorPrimaryTransparent77" />

                </LinearLayout>

                <Button
                    android:id="@+id/p_contact_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p_contact_user"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="20dp"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:textColor="@color/colorPrimary"
                    android:textSize="15sp"
                    android:background="@color/colorSecondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/p_personal_details"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:padding="5dp"
                android:textStyle="bold"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/colorSecondary"
                android:background="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:text="@string/name"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColor="@color/colorSecondary"
                    android:textSize="15sp"
                    android:padding="5dp"/>

                <TextView
                    android:id="@+id/p_name_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/name"
                    android:padding="5dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/colorSecondary"
                    android:background="@color/colorPrimaryTransparent77"
                    android:textSize="15sp" />

            </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/email_id"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@color/colorSecondaryTransparent77"
                        android:textColor="@color/colorSecondary"
                        android:textSize="15sp"
                        android:padding="5dp"/>

                    <TextView
                        android:id="@+id/p_email_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/email_id"
                        android:textStyle="bold"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:autoLink="web"
                        android:textColor="@color/colorSecondary"
                        android:background="@color/colorPrimaryTransparent77" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/gender"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@color/colorSecondaryTransparent77"
                        android:textColor="@color/colorSecondary"
                        android:textSize="15sp"
                        android:padding="5dp"/>

                    <TextView
                        android:id="@+id/p_gender_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gender"
                        android:textStyle="bold"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textColor="@color/colorSecondary"
                        android:background="@color/colorPrimaryTransparent77" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:text="@string/date_of_birth"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColor="@color/colorSecondary"
                    android:textSize="15sp"
                    android:padding="5dp"/>

                <TextView
                    android:id="@+id/p_dob_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date_of_birth"
                    android:textStyle="bold"
                    android:padding="5dp"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:textColor="@color/colorSecondary"
                    android:background="@color/colorPrimaryTransparent77" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/p_other_details"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorSecondary"
                android:background="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/p_course"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@color/colorSecondaryTransparent77"
                        android:textColor="@color/colorSecondary"
                        android:textSize="15sp"
                        android:padding="5dp"/>

                    <TextView
                        android:id="@+id/p_course_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/p_course"
                        android:textStyle="bold"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textColor="@color/colorSecondary"
                        android:background="@color/colorPrimaryTransparent77" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/p_college"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@color/colorSecondaryTransparent77"
                        android:textColor="@color/colorSecondary"
                        android:textSize="15sp"
                        android:padding="5dp"/>

                    <TextView
                        android:id="@+id/p_college_name_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/p_college"
                        android:textStyle="bold"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textColor="@color/colorSecondary"
                        android:background="@color/colorPrimaryTransparent77" />

                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:text="@string/p_department"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@color/colorSecondaryTransparent77"
                    android:textColor="@color/colorSecondary"
                    android:textSize="15sp"
                    android:padding="5dp"/>

                <TextView
                    android:id="@+id/p_department_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/p_department"
                    android:padding="5dp"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:textColor="@color/colorSecondary"
                    android:background="@color/colorPrimaryTransparent77" />

            </LinearLayout>

                <Button
                    android:id="@+id/p_report_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p_report_user"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="20dp"
                    android:padding="10dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone"
                    android:textColor="@color/colorPrimary"
                    android:textSize="15sp"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/colorSecondary" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    </LinearLayout>

        <com.github.clans.fab.FloatingActionMenu
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            fab:menu_icon="@drawable/p_fa_menu"
            fab:menu_colorNormal="@color/colorPrimary"
            fab:menu_colorPressed="@color/colorPrimaryTransparent77"
            fab:menu_colorRipple="@color/colorPrimaryTransparent77"
            fab:menu_fab_size="normal"
            fab:menu_animationDelayPerItem="55"
            fab:menu_backgroundColor="@android:color/transparent"
            fab:menu_buttonSpacing="0dp"
            fab:menu_openDirection="up"
            fab:menu_shadowColor="@color/colorPrimaryTransparent77"
            fab:menu_shadowRadius="4dp"
            fab:menu_shadowXOffset="1dp"
            fab:menu_shadowYOffset="4dp"
            fab:menu_showShadow="true"
            fab:menu_labels_colorNormal="@color/colorPrimary"
            fab:menu_labels_colorPressed="@color/colorPrimaryTransparent77"
            fab:menu_labels_colorRipple="@color/colorPrimaryTransparent77"
            fab:menu_labels_cornerRadius="6dp"
            fab:menu_labels_ellipsize="none"
            fab:menu_labels_hideAnimation="@anim/fab_slide_out_to_right"
            fab:menu_labels_margin="0dp"
            fab:menu_labels_maxLines="-1"
            fab:menu_labels_padding="4dp"
            fab:menu_labels_position="left"
            fab:menu_labels_showAnimation="@anim/fab_slide_in_from_right"
            fab:menu_labels_showShadow="true"
            fab:menu_labels_singleLine="false"
            fab:menu_labels_textColor="@color/colorSecondary"
            fab:menu_labels_textSize="14sp"
            ads:menu_fab_label="@string/hp_db">

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/p_fa_view_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/p_fa_view_profile"
                fab:fab_label="@string/p_fa_view_profile"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/p_fa_edit_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/p_fa_edit_profile"
                fab:fab_label="@string/p_fa_edit_profile"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/p_fa_view_posts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/p_fa_view_posts"
                fab:fab_label="@string/p_fa_view_posts"
                fab:fab_colorNormal="@color/colorSecondary"
                fab:fab_colorPressed="@color/colorPrimaryTransparent77"
                fab:fab_colorRipple="@color/colorPrimaryTransparent77"
                fab:fab_size="mini" />

        </com.github.clans.fab.FloatingActionMenu>

</FrameLayout>

</LinearLayout>