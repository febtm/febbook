<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id ="@+id/hp_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:orientation="vertical"
    android:background="@color/colorGK">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSecondaryTransparent77"
        android:layout_margin="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSecondaryTransparent77"
        android:orientation="vertical">

    <ImageButton
        android:id="@+id/hp_delete"
        android:layout_height="20dp"
        android:layout_width="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginRight="3dp"
        android:layout_marginLeft="3dp"
        android:visibility="gone"
        android:contentDescription="@null"
        android:layout_gravity="end"
        android:background="@drawable/app_cancel"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

        <LinearLayout
            android:id="@+id/hp_user"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="5dp">

            <com.pkmmte.view.CircularImageView
                android:id="@+id/hp_user_image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/hp_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/username"
                android:textColor="@color/colorSecondary"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textSize="14sp"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="start">

            <TextView
                android:id="@+id/hp_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:gravity="center"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <ImageView
                android:id="@+id/hp_item_image"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:contentDescription="@null"
                android:layout_marginBottom="5dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hp_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:layout_gravity="center_vertical"
                android:textSize="14sp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/colorTertiary" />

            <TextView
                android:id="@+id/hp_item_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timestamp"
                android:textSize="12sp"
                android:textColor="@color/colorQuaternary"
                android:gravity="end" />

        </LinearLayout>

        </LinearLayout>

            <TextView
                android:id="@+id/hp_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_post"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_gravity="end"
                android:textColor="@color/colorPrimaryDark"
                android:layout_margin="5dp" />

    </LinearLayout>

    </LinearLayout>

</LinearLayout>