<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="fmt.febulous">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />


    <application
        android:name=".helper.Application"
        android:icon="@drawable/app_logo_main"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme">


        <service
            android:name=".FCMNotToken"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.INSTANCE_ID_EVENT"/>
            </intent-filter>
        </service>


        <service
            android:name=".FCMNotMessaging"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>


       <meta-data
           android:name="com.facebook.sdk.ApplicationId"
           android:value="@string/facebook_app_id"/>


        <activity
            android:name="com.facebook.FacebookActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:replace="android:theme"
            android:label="@string/app_name" />


        <provider
            android:authorities="com.facebook.app.FacebookContentProvider1123721754365610"
            android:name="com.facebook.FacebookContentProvider"
            android:exported="false"/>


        <meta-data
            android:name="io.fabric.ApiKey"
            android:value="40315d3f695a7cd08ecafe26eb0961e9161fb60b" />


        <activity
            android:name=".Login"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>

                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https"
                      android:host="www.google.com" />

                <data android:scheme="https"
                      android:host="www.facebook.com"
                      android:pathPrefix="/fmt.febulous"/>

                <data android:scheme="https"
                      android:host="www.twitter.com"
                      android:pathPrefix="/fmt_febulous"/>

            </intent-filter>

        </activity>


        <activity
            android:name=".SignIn"
            android:label="SIGN IN"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Login" />

            <intent-filter>
                <action android:name="fmt.febulous.SignIn" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".RecoverPassword"
            android:label="RECOVER PASSWORD"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Login" />

            <intent-filter>
                <action android:name="fmt.febulous.RecoverPassword" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".HomePage"
            android:label="HOMEPAGE"
            android:theme="@style/AppTheme.NoActionBar">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Login" />

            <intent-filter>
                <action android:name="fmt.febulous.HomePage" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".PostView"
            android:label="VIEW A POST"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />

            <intent-filter>
                <action android:name="fmt.febulous.PostView" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".Profile"
            android:label="PROFILE"
            android:theme="@style/AppTheme.NoActionBar">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />

            <intent-filter>
                <action android:name="fmt.febulous.Profile" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".ModifyProfile"
            android:label="MODIFY PROFILE"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Profile" />

            <intent-filter>
                <action android:name="fmt.febulous.ModifyProfile" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".helper.ViewImage"
            android:label="VIEW IMAGE"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Profile" />

            <intent-filter>
                <action android:name="fmt.febulous.ViewImage" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".Messenger"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />

        </activity>


        <activity
            android:name=".MessengerItem"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Messenger" />

        </activity>


        <activity
            android:name=".Notifications"
            android:label="NOTIFICATIONS"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />

            <intent-filter>
                <action android:name="fmt.febulous.Notifications" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".ContactUs"
            android:label="CONTACT US"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />

            <intent-filter>
                <action android:name="fmt.febulous.ContactUs" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".Dashboard"
            android:label="DASHBOARD"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />

            <intent-filter>
                <action android:name="fmt.febulous.Dashboard" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".PostTemplate"
            android:label="POST TEMPLATE"
            android:theme="@style/AppTheme.NoActionBar">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Dashboard" />

            <intent-filter>
                <action android:name="fmt.febulous.PostTemplate" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".PostItem"
            android:label="POST TO FEBULOUS"
            android:theme="@style/AppTheme">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".PostTemplate" />

            <intent-filter>
                <action android:name="fmt.febulous.PostItem" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


    </application>

       
</manifest>